// Cape Town Housing Ground -- DAX measures
// Generated by scripts/build_powerbi_model.py; the TMDL model carries
// the same definitions, so edit the script rather than either output.


// ---- capacity --------------------------------------------------
// Dwelling units the land could carry at the assumed typology density.
Total Units = SUM ( FactSite[units_total] )
// Units targeted at the sub-R3 500/month band (65% of yield).
Social Units = SUM ( FactSite[units_social] )
Developable Ha = SUM ( FactSite[dev_ha] )
Site Count = DISTINCTCOUNT ( FactSite[site_id] )
// Units per developable hectare.
Avg Density = DIVIDE ( [Total Units], [Developable Ha] )

// ---- zoning ----------------------------------------------------
// Units possible under current zoning, with no rezoning.
Buildable Now = SUM ( FactSite[units_asofright] )
Needs Rezoning = SUM ( FactSite[units_rezoning] )
% Blocked By Zoning = DIVIDE ( [Needs Rezoning], [Total Units] )
// Hectares whose zone permits no residential use at all.
Ha Blocked = CALCULATE ( [Developable Ha], KEEPFILTERS ( DimSite[zoning_blocked] = TRUE ) )
Blocked Sites = CALCULATE ( [Site Count], KEEPFILTERS ( DimSite[zoning_blocked] = TRUE ) )

// ---- scoring ---------------------------------------------------
// Mean normalised 0-100 criterion score in the current filter context.
Avg Score = AVERAGE ( FactScore[score] )
// Efficiency-weighted suitability.
Weighted Score = SUMX ( VALUES ( DimCriterion[criterion] ), [Avg Score] * CALCULATE ( SELECTEDVALUE ( DimCriterion[weight_efficiency] ) ) )
Weighted Score Redress = SUMX ( VALUES ( DimCriterion[criterion] ), [Avg Score] * CALCULATE ( SELECTEDVALUE ( DimCriterion[weight_redress] ) ) )

// ---- scenarios -------------------------------------------------
Rank Efficiency = CALCULATE ( MIN ( FactRanking[rank] ), DimScenario[scenario] = "Efficiency" )
Rank Redress = CALCULATE ( MIN ( FactRanking[rank] ), DimScenario[scenario] = "Redress" )
// Negative means the site climbs once Group Areas history is priced in.
Rank Shift = [Rank Redress] - [Rank Efficiency]
Climbs Under Redress = CALCULATE ( [Site Count], KEEPFILTERS ( FactSite[rank_shift] < 0 ) )

// ---- delivery --------------------------------------------------
Units Released = SUM ( FactDelivery[units_released] )
Cumulative Units = CALCULATE ( [Units Released], FILTER ( ALL ( DimYear[year] ), DimYear[year] <= MAX ( DimYear[year] ) ) )
Pct Of Pipeline Delivered = DIVIDE ( [Cumulative Units], CALCULATE ( [Total Units], ALL ( DimSite ) ) )

// ---- robustness ------------------------------------------------
// Mean 5th-95th percentile rank interval under weight noise.
Rank Swing Weights = AVERAGEX ( FactSite, FactSite[rank_p95] - FactSite[rank_p05] )
// Same, under estimate noise. Wider than the weight test.
Rank Swing Inputs = AVERAGEX ( FactSite, FactSite[in_rank_p95] - FactSite[in_rank_p05] )
Stable Top Ten = CALCULATE ( [Site Count], KEEPFILTERS ( FactSite[pct_top10] >= 0.9 ) )
